# CampusFlow Environment Variables Configuration Template
# Copy this file to .env and configure for your local environment

# Server Port
PORT=8080

# Database Configuration (PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/campusflow_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Timezone Setting (UTC recommended)
TZ=UTC
